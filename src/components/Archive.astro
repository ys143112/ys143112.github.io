---
import PostRow from './PostRow.astro';
import { categories, categorySlug, path, postSummary, type Post } from '../lib/posts';
import { analyzeMarkdown } from '../lib/markdown.mjs';
interface Props { posts: Post[]; selected?: string; }
const { posts, selected } = Astro.props;
---
<section class="archive shell">
  <div class="archive-toolbar"><nav class="category-tabs" aria-label="카테고리"><a href={path('blog/')} aria-current={!selected ? 'page' : undefined}>전체</a>{categories.map(category => <a href={path(`category/${categorySlug[category]}/`)} aria-current={selected === category ? 'page' : undefined}>{category}</a>)}</nav>
  <div class="search-box" data-search-controls hidden><label for="post-search" class="sr-only">현재 목록에서 제목, 본문, 태그 검색</label><input id="post-search" type="search" placeholder={selected ? `${selected}에서 검색…` : '전체 기록에서 검색…'} autocomplete="off" aria-controls="post-list" /></div></div>
  <p id="search-count" class="search-count" aria-live="polite">{posts.length}개의 기록</p>
  <div id="post-list">{posts.map((post,index) => <div data-post data-search={`${post.data.title} ${postSummary(post)} ${analyzeMarkdown(post.body || '').searchText} ${post.data.tags.join(' ')}`}><PostRow post={post} index={index+1}/></div>)}</div>
  {posts.length === 0 && <div class="empty-state"><h3>아직 공개된 기록이 없습니다.</h3><p>새로운 기록을 준비하고 있습니다.</p><a class="text-link" href={path('blog/')}>전체 기록 보기 →</a></div>}
  <div id="no-results" class="empty-state" hidden><h3>일치하는 기록이 없습니다.</h3><p>다른 단어로 검색하거나 검색어를 지워보세요.</p><button class="secondary-button" id="clear-search" type="button">검색어 지우기</button></div>
</section>
<script>
  const input = document.querySelector<HTMLInputElement>('#post-search');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('ko-KR');
  const entries = rows.map(row => ({row, text: normalize(row.dataset.search || '')}));
  document.querySelector<HTMLElement>('[data-search-controls]')?.removeAttribute('hidden');
  function filter(syncUrl = true) {
    if (!input) return;
    const query = input.value.trim();
    const terms = normalize(query).split(/\s+/).filter(Boolean);
    let count = 0;
    entries.forEach(({row,text}) => { row.hidden = !terms.every(term => text.includes(term)); if(!row.hidden) count++; });
    const status = document.querySelector('#search-count');
    if(status) status.textContent = query ? `검색 결과 ${count}개 · 전체 ${rows.length}개` : `${rows.length}개의 기록`;
    const empty = document.querySelector<HTMLElement>('#no-results');
    if(empty) empty.hidden = count > 0 || rows.length === 0;
    const url = new URL(location.href);
    if(query) url.searchParams.set('q',query); else url.searchParams.delete('q');
    if(syncUrl) history.replaceState(null,'',url);
    document.querySelectorAll<HTMLAnchorElement>('.category-tabs a').forEach(link => {
      const categoryUrl = new URL(link.href);
      if(query) categoryUrl.searchParams.set('q',query); else categoryUrl.searchParams.delete('q');
      link.href = categoryUrl.href;
    });
  }
  function restore() { if(input) input.value = new URL(location.href).searchParams.get('q') || ''; filter(false); }
  input?.addEventListener('input', () => filter());
  document.querySelector('#clear-search')?.addEventListener('click', () => { if(input) { input.value=''; filter(); input.focus(); } });
  window.addEventListener('pageshow', restore);
  window.addEventListener('popstate', restore);
  restore();
</script>
